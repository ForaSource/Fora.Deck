# Полная версия выпуска, включая prerelease/build, берётся только из VERSION.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../VERSION")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../VERSION" FORADECK_RELEASE_VERSION)
string(STRIP "${FORADECK_RELEASE_VERSION}" FORADECK_RELEASE_VERSION)

set(foradeck_semver_number "(0|[1-9][0-9]*)")
set(foradeck_semver_identifier "[0-9A-Za-z-]+")
if(NOT FORADECK_RELEASE_VERSION MATCHES
        "^${foradeck_semver_number}\\.${foradeck_semver_number}\\.${foradeck_semver_number}(-${foradeck_semver_identifier}(\\.${foradeck_semver_identifier})*)?(\\+${foradeck_semver_identifier}(\\.${foradeck_semver_identifier})*)?$")
    message(FATAL_ERROR "VERSION must contain a valid SemVer version (major.minor.patch[-prerelease][+build]).")
endif()
set(FORADECK_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(FORADECK_VERSION_MINOR "${CMAKE_MATCH_2}")
set(FORADECK_VERSION_PATCH "${CMAKE_MATCH_3}")
set(FORADECK_NUMERIC_VERSION "${FORADECK_VERSION_MAJOR}.${FORADECK_VERSION_MINOR}.${FORADECK_VERSION_PATCH}")
string(REGEX REPLACE "\\+.*$" "" foradeck_version_without_build "${FORADECK_RELEASE_VERSION}")
string(REGEX REPLACE "^[0-9]+\\.[0-9]+\\.[0-9]+" "" foradeck_prerelease "${foradeck_version_without_build}")
set(FORADECK_IS_PRERELEASE FALSE)
set(FORADECK_WINDOWS_FILE_FLAGS "0")
set(FORADECK_DEBIAN_VERSION "${FORADECK_NUMERIC_VERSION}")
if(NOT foradeck_prerelease STREQUAL "")
    set(FORADECK_IS_PRERELEASE TRUE)
    set(FORADECK_WINDOWS_FILE_FLAGS "VS_FF_PRERELEASE")
    string(SUBSTRING "${foradeck_prerelease}" 1 -1 foradeck_prerelease)
    string(REPLACE "." ";" foradeck_prerelease_parts "${foradeck_prerelease}")
    string(APPEND FORADECK_DEBIAN_VERSION "~")
    # Debian и SemVer по-разному сравнивают смешанные идентификаторы. Кодируем тип
    # и ASCII-порядок; завершающий ~ сохраняет порядок префиксов и списков.
    set(foradeck_ascii_order "-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz")
    set(foradeck_encoding_alphabet "abcdefghijklmnopqrstuvwxyz")
    foreach(foradeck_part IN LISTS foradeck_prerelease_parts)
        if(foradeck_part MATCHES "^[0-9]+$")
            if(foradeck_part MATCHES "^0[0-9]+$")
                message(FATAL_ERROR "Numeric SemVer prerelease identifiers must not contain leading zeroes.")
            endif()
            string(APPEND FORADECK_DEBIAN_VERSION "n${foradeck_part}~")
        else()
            string(APPEND FORADECK_DEBIAN_VERSION "s")
            string(LENGTH "${foradeck_part}" foradeck_part_length)
            math(EXPR foradeck_part_last "${foradeck_part_length} - 1")
            foreach(foradeck_index RANGE 0 ${foradeck_part_last})
                string(SUBSTRING "${foradeck_part}" ${foradeck_index} 1 foradeck_character)
                string(FIND "${foradeck_ascii_order}" "${foradeck_character}" foradeck_code)
                math(EXPR foradeck_high "${foradeck_code} / 26")
                math(EXPR foradeck_low "${foradeck_code} % 26")
                string(SUBSTRING "${foradeck_encoding_alphabet}" ${foradeck_high} 1 foradeck_high)
                string(SUBSTRING "${foradeck_encoding_alphabet}" ${foradeck_low} 1 foradeck_low)
                string(APPEND FORADECK_DEBIAN_VERSION "${foradeck_high}${foradeck_low}")
            endforeach()
            string(APPEND FORADECK_DEBIAN_VERSION "~")
        endif()
    endforeach()
endif()
# Build metadata различает артефакты, но не влияет на приоритет SemVer/Debian.
set(FORADECK_WINDOWS_NUMERIC_VERSION "${FORADECK_NUMERIC_VERSION}.0")
