#!/bin/sh
set -eu

APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
export APPDIR

# Child applications must receive the original desktop libraries and plugins.
export FORADECK_ORIGINAL_LD_LIBRARY_PATH="${LD_LIBRARY_PATH-}"
export FORADECK_ORIGINAL_LD_LIBRARY_PATH_SET="${LD_LIBRARY_PATH+x}"
export FORADECK_ORIGINAL_QT_PLUGIN_PATH="${QT_PLUGIN_PATH-}"
export FORADECK_ORIGINAL_QT_PLUGIN_PATH_SET="${QT_PLUGIN_PATH+x}"
export FORADECK_ORIGINAL_QT_QPA_PLATFORM_PLUGIN_PATH="${QT_QPA_PLATFORM_PLUGIN_PATH-}"
export FORADECK_ORIGINAL_QT_QPA_PLATFORM_PLUGIN_PATH_SET="${QT_QPA_PLATFORM_PLUGIN_PATH+x}"
export FORADECK_APPIMAGE="${APPIMAGE-}"

export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$APPDIR/usr/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$APPDIR/usr/plugins/platforms"
exec "$APPDIR/usr/bin/foradeck" "$@"
